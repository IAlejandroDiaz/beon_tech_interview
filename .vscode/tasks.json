{
  // Build task used by the debug configs: compiles the servers to dist/*.js
  // with sourcemaps (tsconfig.debug.json) so breakpoints bind reliably.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:debug",
      "type": "shell",
      "command": "npx tsc -p tsconfig.debug.json",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.nvm/versions/node/v26.13.0/bin:${env:PATH}"
        }
      },
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "silent", "panel": "shared" }
    }
  ]
}
