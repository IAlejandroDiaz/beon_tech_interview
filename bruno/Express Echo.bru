meta {
  name: Express Echo
  type: http
  seq: 3
}

post {
  url: {{expressUrl}}/echo
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "message": "hello from bruno"
  }
}

vars:pre-request {
  expressUrl: http://localhost:3000
}

assert {
  res.status: eq 200
  res.body.received: eq hello from bruno
}

tests {
  test("echo returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("echo returns the message back", function () {
    expect(res.getBody().received).to.equal("hello from bruno");
  });
}
