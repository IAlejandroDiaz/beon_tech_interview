meta {
  name: FastAPI Echo
  type: http
  seq: 6
}

post {
  url: {{fastapiUrl}}/echo
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "message": "hello from bruno"
  }
}

vars:pre-request {
  fastapiUrl:  http://127.0.0.1:8000
}

assert {
  res.status: eq 200
  res.body.received: eq hello from bruno
  res.body.length: eq 16
}

tests {
  test("fastapi echo returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("fastapi echo returns the message back", function () {
    expect(res.getBody().received).to.equal("hello from bruno");
  });
}
